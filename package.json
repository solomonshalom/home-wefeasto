{
  "name": "wefeasto-svelte",
  "version": "1.0.0",
  "private": true,
  "description": "Wefeasto ecommerce prototype — 1:1 Svelte port of the static site",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "sync:cms": "node scripts/sync-cms.mjs --force",
    "prebuild": "node scripts/sync-cms.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo \"\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --project=ui",
    "test:e2e:full": "playwright test --project=full",
    "test:e2e:harness": "node --test e2e/full/support/admin.test.mjs scripts/e2e/files.test.mjs scripts/e2e/config.test.mjs",
    "test:regression": "node tools/regression.mjs",
    "e2e:stack": "node scripts/e2e-stack.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
