# Wefeasto CMS environment. Copy to .env (gitignored) and adjust. Dev values match docker-compose.yml.

# Postgres (docker compose: databases wefeasto = dev, wefeasto_test = integration tests, wefeasto_e2e = e2e)
DATABASE_URI=postgres://wefeasto:wefeasto@127.0.0.1:54329/wefeasto
# Optional: pg pool size (default 10). Use the provider's pooled URL in production.
DATABASE_POOL_MAX=

# At least 32 characters in production (boot refuses otherwise). Also keys the guest order tokens.
PAYLOAD_SECRET=dev-secret-change-me-at-least-32-characters
# Public URL of this CMS (admin, Razorpay webhook + callback). Added to the CORS/CSRF allowlist.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Storefront base URL: email links (verify, reset password, order status) point here.
STOREFRONT_URL=http://localhost:5173
# Comma-separated origins allowed for credentialed CORS + CSRF (cookie auth).
STOREFRONT_ORIGINS=http://localhost:5173,http://localhost:4173

# mock | razorpay. mock is refused when NODE_ENV=production unless ALLOW_MOCK_PAYMENTS=1 (e2e/preview only),
# and always refused when APP_ENV/VERCEL_ENV=production (the live shop).
PAYMENTS_MODE=mock
ALLOW_MOCK_PAYMENTS=
# Required when PAYMENTS_MODE=razorpay. rzp_live_ keys need NODE_ENV=production; APP_ENV=production needs rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Previous webhook secret, accepted during rotation.
RAZORPAY_WEBHOOK_SECRET_OLD=
# Optional: 'production' for the live shop (defaults to VERCEL_ENV). Drives the key-prefix check and refuses mock.
APP_ENV=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/payload-jobs/run.
CRON_SECRET=dev-cron-secret

# SMTP (dev: Mailpit, UI at http://127.0.0.1:54326). Empty SMTP_HOST = emails are logged to the console.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
# Optional: 1 for implicit TLS (port 465 implies it).
SMTP_SECURE=
EMAIL_FROM="Wefeasto <hello@wefeasto.com>"

# Storefront rebuild hook (Vercel Deploy Hook URL). Empty = no-op.
VERCEL_DEPLOY_HOOK_URL=
# Media storage on Vercel Blob. Empty = local ./media folder.
BLOB_READ_WRITE_TOKEN=

# 1 disables the in-memory rate limiter (tests).
RATE_LIMIT_DISABLED=
